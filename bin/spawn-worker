#!/usr/bin/env bash
set -euo pipefail

WI_ID="${1:-}"
if [[ -z "$WI_ID" ]]; then echo "usage: spawn-worker <work-item-id>" >&2; exit 2; fi

COS_BIN="$HOME/.claude/cos/bin/cos"
CLAUDE_BIN="$HOME/.local/bin/claude"
PLUGIN_DIR="$HOME/Repos/claude-projects"
TMUX_SESSION="cos-workers"

[[ -x "$COS_BIN" ]] || { echo "cos CLI not found at $COS_BIN" >&2; exit 2; }
[[ -x "$CLAUDE_BIN" ]] || { echo "claude not found at $CLAUDE_BIN" >&2; exit 2; }

SESSION_ID="$("$COS_BIN" session-new --work-item "$WI_ID" --kind worker | tail -1)"
[[ -n "$SESSION_ID" ]] || { echo "session-new failed" >&2; exit 1; }
echo "[spawn-worker] session: $SESSION_ID"

echo "[spawn-worker] creating worktrees…"
"$COS_BIN" worker-setup "$WI_ID"
PRIMARY_WT="$("$COS_BIN" worker-primary-worktree "$WI_ID")"
[[ -n "$PRIMARY_WT" ]] || PRIMARY_WT="$HOME"
echo "[spawn-worker] primary worktree: $PRIMARY_WT"

PROMPT_FILE="$(mktemp -t cos-prompt-XXXXXX).md"
"$COS_BIN" worker-prompt "$WI_ID" --session "$SESSION_ID" > "$PROMPT_FILE"

tmux has-session -t "$TMUX_SESSION" 2>/dev/null || tmux new-session -d -s "$TMUX_SESSION" -n _placeholder -c "$HOME"
WINDOW_NAME="$("$COS_BIN" worker-window-name "$WI_ID" 2>/dev/null)"
if [[ -z "$WINDOW_NAME" ]]; then
  WINDOW_NAME="${WI_ID#wi-}"; WINDOW_NAME="${WINDOW_NAME:0:18}"
fi
tmux new-window -t "$TMUX_SESSION" -n "$WINDOW_NAME" -c "$PRIMARY_WT"
WINDOW_TARGET="$TMUX_SESSION:$WINDOW_NAME"

WORKER_LOG="$HOME/.claude/cos/logs/worker-$SESSION_ID.log"
mkdir -p "$HOME/.claude/cos/logs"

# Key fixes:
#   1. stdin < /dev/null — claude -p doesn't block on stdin when in a pipe.
#   2. trap EXIT — on ANY shell exit (normal OR signal like SIGHUP from tmux kill-window),
#      call worker-done --failed with the log tail. The idempotency check in cmdWorkerDone
#      ensures a successful worker-done --pr-url is not clobbered.
#   3. trailing `; exit` — the shell would otherwise sit at an idle zsh prompt
#      after claude finishes, leaving a ghost tmux window. Exiting the shell
#      lets tmux close the window (remain-on-exit defaults off).
CLAUDE_CMD="trap 'TAIL=\$(tail -c 1500 \"$WORKER_LOG\" 2>/dev/null | tr \"\\n\" \" \" | sed \"s/  */ /g\"); $COS_BIN worker-done \"$SESSION_ID\" --failed \"worker shell exited. last output: \${TAIL:-<empty>}\" 2>/dev/null || true' EXIT; $CLAUDE_BIN --plugin-dir \"$PLUGIN_DIR\" --dangerously-skip-permissions -p \"\$(cat \"$PROMPT_FILE\")\" < /dev/null 2>&1 | tee \"$WORKER_LOG\"; exit"
tmux send-keys -t "$WINDOW_TARGET" "$CLAUDE_CMD" Enter

echo "[spawn-worker] dispatched $WI_ID in tmux $WINDOW_TARGET"
echo "[spawn-worker] attach: tmux attach -t $WINDOW_TARGET"
echo "$SESSION_ID"
